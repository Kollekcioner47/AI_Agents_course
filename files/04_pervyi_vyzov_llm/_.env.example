# Шаблон файла .env для занятия 4.
# Скопируйте этот файл в папку проекта assistant и переименуйте
# в .env (имя без расширения, начинается с точки). Затем заполните
# ключ для выбранного провайдера.

# Вариант A. NeuralDeep (облако).
# Вставьте сюда свой ключ после знака «=» без кавычек и пробелов.
NEURALDEEP_API_KEY=
NEURALDEEP_BASE_URL=https://api.neuraldeep.ru/v1
NEURALDEEP_MODEL=qwen3.8-27b

# Вариант B. Ollama (локальная модель).
# Эти строки нужны, если вы выбрали Ollama. Оставьте как есть.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b
